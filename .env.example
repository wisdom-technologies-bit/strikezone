# Names only. Copy to .env.local and fill in locally. Never commit a real value.
# .env.local is gitignored; this file is the only env file that may be committed.

# Browser-visible. Safe only because RLS guards the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Browser-visible. REST base and the Colyseus bare origin (no path).
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_SOCKET_URL=

# Server only. Never read outside a file starting with: import "server-only"
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_API_KEY=

# Server only. The admin area lives under /<ADMIN_ROUTE_SLUG>; there is no /admin.
ADMIN_ROUTE_SLUG=

# Server only. Set to 1 to expose the design gallery at /dev/ui and the data page
# at /dev/data. Anything else (or unset) answers 404 on both, including in production.
GALLERY_PREVIEW=
